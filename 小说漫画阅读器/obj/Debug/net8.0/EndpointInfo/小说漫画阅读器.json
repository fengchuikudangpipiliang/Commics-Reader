    "/api/Mangadex/GetMangaIdByTitle": {
      "get": {
        "tags": [
          "Mangadex"
        ],
        "summary": "根据漫画标题模糊搜索 ID",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "漫画标题关键字",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "一次请求的个数",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Mangadex/GetMangaByTags": {
      "get": {
        "tags": [
          "Mangadex"
        ],
        "summary": "根据标签得到匹配的漫画uuid",
        "parameters": [
          {
            "name": "includedTagNames",
            "in": "query",
            "description": "要包括的标签",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "excludedTagNames",
            "in": "query",
            "description": "要去除的标签",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "一次请求的个数",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Mangadex/GetCoverImg": {
      "get": {
        "tags": [
          "Mangadex"
        ],
        "summary": "得到漫画封面的图片的方法,uuid+文件名,可以在.jpg前面加.256或者.512",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "description": "漫画的Uuid",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileName",
            "in": "query",
            "description": "漫画对应的封面文件名",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Mangadex/GetCommetnById": {
      "get": {
        "tags": [
          "Mangadex"
        ],
        "summary": "根据漫画的uuid得到漫画的评分",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "description": "漫画的uuid",
            "schema": {
              "type": "string"
