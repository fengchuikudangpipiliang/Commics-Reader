              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MangaStatisticsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MangaStatisticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Mangadex/GetMangaWithRelationship": {
      "get": {
        "tags": [
          "Mangadex"
        ],
        "summary": "根据标题得到漫画的的所有信息（是漫画的所有信息加封面信息）",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "想要搜索的漫画标题",
            "schema": {
              "type": "string"
            }
